# Copy this file to .streamlit/secrets.toml and replace every placeholder.
# Never commit the copied file: it is ignored by the repository.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"

# Enable Google and GitHub connections in Auth0 Universal Login. Both then
# appear as choices behind the single Orion login button.
[auth.auth0]
client_id = "replace-with-auth0-application-client-id"
client_secret = "replace-with-auth0-application-client-secret"
server_metadata_url = "https://dev-gsrstdf0m35stzh3.us.auth0.com/.well-known/openid-configuration"

[orion]
# Must match backend/.env: ORION_IDENTITY_BRIDGE_SECRET.
identity_bridge_secret = "replace-with-the-same-random-secret-used-by-backend"
