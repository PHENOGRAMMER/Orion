# Orion production configuration template.
# Copy this file to backend/.env and replace every placeholder before use.

APP_NAME=Orion
VERSION=1.0.0
DEBUG=False

# Production must require API keys.
AUTH_ENABLED=True
ADMIN_API_KEY=replace-with-a-long-random-bootstrap-secret

# Auth0 API validation. The issuer must be your Auth0 tenant URL. The audience
# is the identifier of the Auth0 API you create for Orion.
AUTH0_ENABLED=True
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.orion.local
AUTH0_ALGORITHMS=RS256
ORION_IDENTITY_BRIDGE_SECRET=replace-with-the-same-random-secret-used-by-streamlit
ORION_IDENTITY_BRIDGE_MAX_AGE_SECONDS=300

# Keep false for the free/lightweight deployment. Enable only when the model
# runtime and fine-tuned adapter are supplied separately.
ORION_LLM_ENABLED=False

# Set this to the mounted repository directory in the container.
PROJECT_ROOT=/workspace
ALLOWED_ROOTS=/workspace
ALLOW_UNSAFE_SCAN_PATHS=False

# Restrict browser clients to the actual frontend origin(s).
ALLOW_ORIGINS=http://localhost:8501

# Durable state location.
PERSISTENCE_DB=/data/orion/orion.db

# Optional LoRA adapter path when ORION_LLM_ENABLED=True.
ORION_ADAPTER_PATH=/app/fine_tuned_model
